# env/kafka-broker.env.example
# Copy to env/kafka-broker.env (gitignored)

KAFKA_IMAGE=apache/kafka:latest
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_CLUSTER_ID
CONTROLLER_QUORUM_VOTERS=1@<CONTROLLER01_HOST>:9093,2@<CONTROLLER02_HOST>:9093,3@<CONTROLLER03_HOST>:9093

# Broker listener bind address
BROKER_LISTENER=BROKER://<BROKER_HOST>:9092
