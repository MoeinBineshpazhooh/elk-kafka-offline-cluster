# env/kafka-controller.env.example
# Copy to env/kafka-controller.env (gitignored)

KAFKA_IMAGE=apache/kafka:latest

# Same cluster id on all controllers/brokers (generated once, reused forever)
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_CLUSTER_ID

# Controller quorum voters (must match node ids and example addresses)
CONTROLLER_QUORUM_VOTERS=1@192.0.2.11:9093,2@192.0.2.12:9093,3@192.0.2.13:9093
