# Copy to env/filebeat.env locally. Keep the real file out of Git.

FILEBEAT_VERSION=9.0.1

KAFKA_BOOTSTRAP_SERVERS=<BROKER01_HOST>:9092,<BROKER02_HOST>:9092,<BROKER03_HOST>:9092
KAFKA_TOPIC=demo-application-logs
KAFKA_USERNAME=filebeat
KAFKA_PASSWORD=CHANGE_ME_FILEBEAT_KAFKA_PASSWORD

# Kafka authentication mode used by this example.
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
