# env/logstash.env.example
# Copy to env/logstash.env (gitignored) and replace placeholders locally.

LOGSTASH_VERSION=9.2.4
LS_JAVA_OPTS=-Xms512m -Xmx512m

# Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=<KAFKA_BROKER_1>:9092,<KAFKA_BROKER_2>:9092,<KAFKA_BROKER_3>:9092

# Ruby array syntax required by the Logstash Kafka input plugin.
KAFKA_TOPICS=["demo-application-logs"]

# Shared consumer group across Logstash instances for partition balancing.
KAFKA_GROUP_ID=demo-logstash-consumers

KAFKA_CLIENT_ID=logstash
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_THREADS=2

# Kafka authentication
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=logstash
KAFKA_PASSWORD=CHANGE_ME_KAFKA_LOGSTASH_PASSWORD

# Elasticsearch output
ELASTICSEARCH_HOSTS=https://<ELASTICSEARCH_HOST>:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD

# Elasticsearch rollover alias
ELASTICSEARCH_INDEX_ALIAS=demo-logs

# Elasticsearch ILM policy already created on the cluster
ELASTICSEARCH_ILM_POLICY=observability-ilm-policy

# TLS CA for Elasticsearch (mounted by Docker Compose)
ELASTICSEARCH_SSL_CACERT=/usr/share/logstash/config/certs/ca/ca.crt
ELASTICSEARCH_SSL_VERIFICATIONMODE=full
